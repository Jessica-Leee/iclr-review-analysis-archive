# Copy to .env and set your own key locally. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: choose a model supported by your account. --model overrides this.
# ANTHROPIC_MODEL=your-model-id

# Optional OpenReview settings. The ingestion command reads exported environment
# variables; it does not load .env automatically. Public data needs no login.
# OPENREVIEW_API_BASEURL=https://api2.openreview.net
# OPENREVIEW_USERNAME=
# OPENREVIEW_PASSWORD=
